{
  "name": "elecit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:production": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && gh-pages -d dist",
    "analyze": "npm run build",
    "analyze:open": "open dist/stats.html",
    "lighthouse": "lhci autorun",
    "lighthouse:mobile": "lhci autorun --preset=mobile",
    "lighthouse:desktop": "lhci autorun --preset=desktop",
    "perf:measure": "node scripts/measurePerformance.js",
    "perf:web-vitals": "node scripts/checkWebVitals.js",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "a11y:single": "pa11y http://localhost:5173/",
    "check:contrast": "node scripts/checkColorContrast.js",
    "test:perf": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run lighthouse\"",
    "test:a11y": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run a11y\"",
    "test:all": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run lighthouse && npm run a11y && npm run check:contrast\""
  },
  "dependencies": {
    "@directus/sdk": "^20.2.0",
    "@reduxjs/toolkit": "^2.11.0",
    "@tailwindcss/vite": "^4.1.17",
    "framer-motion": "^12.23.26",
    "i18next": "^25.6.3",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "react-icons": "^5.5.0",
    "react-pdf": "^10.4.1",
    "react-phone-input-2": "^2.15.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.6",
    "tailwindcss": "^4.1.17",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@lhci/cli": "^0.15.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.11.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "polished": "^4.3.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.37.0",
    "vite": "^7.2.4",
    "wait-on": "^8.0.1",
    "webpack-bundle-analyzer": "^5.2.0"
  }
}
